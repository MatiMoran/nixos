{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "showThinking": false
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "cp *": "allow",
      "diff *": "allow",
      "dpkg *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh api *": "allow",
      "gh pr create *": "allow",
      "git add *": "allow",
      "git branch *": "allow",
      "git ls-files *": "allow",
      "git log *": "allow",
      "git push *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "hexdump *": "allow",
      "home-manager *": "allow",
      "ls *": "allow",
      "man *": "allow",
      "mkdir *": "allow",
      "nix eval *": "allow",
      "nix flake check *": "allow",
      "nix search *": "allow",
      "nixos-version": "allow",
      "pactl *": "allow",
      "pgrep *": "allow",
      "poetry env info *": "allow",
      "poetry init *": "allow",
      "poetry lock *": "allow",
      "poetry version *": "allow",
      "ps *": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "rpm *": "allow",
      "sleep *": "allow",
      "stat *": "allow",
      "strings *": "allow",
      "systemctl --user status *": "allow",
      "systemctl status *": "allow",
      "tail *": "allow",
      "touch *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "xxd *": "allow",
      "curl *": "ask",
      "mv *": "ask",
      "rm -f *": "ask",
      "rm -rf *": "ask",
      "wget *": "ask",
      ":(){:|:&};:": "deny",
      "> *": "deny",
      "chmod -R *": "deny",
      "chown *": "deny",
      "curl * | bash *": "deny",
      "curl * | sh *": "deny",
      "dd *": "deny",
      "diskutil *": "deny",
      "fdisk *": "deny",
      "git checkout -- . *": "deny",
      "git clean -f *": "deny",
      "git push --force *": "deny",
      "git reset --hard *": "deny",
      "kill -9 *": "deny",
      "killall *": "deny",
      "mkfs *": "deny",
      "reboot *": "deny",
      "shred *": "deny",
      "shutdown *": "deny",
      "wget * | bash *": "deny",
      "wget * | sh *": "deny"
    },
    "external_directory": "ask"
  }
}
