{
  "permissions": {
    "allow": [
      "Bash(bq version *)",
      "Bash(command -v bq)",
      "Bash(dataflow-toolkit *)",
      "Bash(fury ai *)",
      "Bash(fury token *)",
      "Bash(gcloud auth *)",
      "Bash(gh api *)",
      "Bash(gh pr create*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(open *)",
      "Bash(pbcopy)",
      "Bash(pip install *)",
      "Bash(poetry env info*)",
      "Bash(poetry init*)",
      "Bash(poetry lock*)",
      "Bash(poetry version*)",
      "Bash(python3 *)",
      "mcp__bigquery__execute_query",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__claude_ai_Atlassian__getTransitionsForJiraIssue",
      "mcp__claude_ai_Atlassian__lookupJiraAccountId",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Slack__slack_read_thread"
    ],
    "deny": [
      "Bash(chmod -R *)",
      "Bash(chown *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(fdisk *)",
      "Bash(git checkout -- . *)",
      "Bash(git clean -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(mkfs *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(wget * | bash *)",
      "Bash(wget * | sh *)"
    ],
    "ask": [
      "Bash(mv *)",
      "Bash(rm -f *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "true",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/confirm-destructive.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "true",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "fury-cli@meli-claude-marketplace": true,
    "github@fury-services-claude-plugins": true,
    "google-workspace@fury-services-claude-plugins": true,
    "meli-genai-costs@meli-claude-marketplace": true,
    "prompt-improver@fury-services-claude-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "verdiflow@fury-services-claude-plugins": true,
    "fda@meli-claude-marketplace": true,
    "dataflow-develop-toolkit@meli-claude-marketplace": true,
    "meli-security-expert@cyber-plugins-marketplace": true
  },
  "extraKnownMarketplaces": {
    "fury-services-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "melisource/fury_services-claude-plugins"
      },
      "autoUpdate": true
    },
    "meli-claude-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:melisource/fury_meli-claude-marketplace.git"
      },
      "autoUpdate": true
    },
    "cyber-plugins-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:melisource/fury_cyber-plugins-marketplace.git"
      }
    }
  },
  "language": "espanol",
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true
}
