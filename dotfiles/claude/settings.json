{
  "effortLevel": "high",
  "enabledPlugins": {
    "dataflow-develop-toolkit@meli-claude-marketplace": true,
    "fda@meli-claude-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "fury-cli@meli-claude-marketplace": true,
    "meli-genai-costs@meli-claude-marketplace": true,
    "meli-security-expert@cyber-plugins-marketplace": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "cyber-plugins-marketplace": {
      "source": {
        "source": "git",
        "url": "git@github.com:melisource/fury_cyber-plugins-marketplace.git"
      }
    },
    "meli-claude-marketplace": {
      "autoUpdate": true,
      "source": {
        "source": "git",
        "url": "git@github.com:melisource/fury_meli-claude-marketplace.git"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "async": true,
            "command": "true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "hooks": [],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/scripts/confirm-destructive.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "true",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "language": "espanol",
  "permissions": {
    "allow": [
      "Bash(bq version *)",
      "Bash(command -v bq)",
      "Bash(dataflow-toolkit *)",
      "Bash(fury ai *)",
      "Bash(fury token *)",
      "Bash(gcloud auth *)",
      "Bash(gh api *)",
      "Bash(gh pr create*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(open *)",
      "Bash(pbcopy)",
      "Bash(pip install *)",
      "Bash(poetry env info*)",
      "Bash(poetry init*)",
      "Bash(poetry lock*)",
      "Bash(poetry version*)",
      "Bash(python3 *)",
      "mcp__bigquery__execute_query",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__claude_ai_Atlassian__getTransitionsForJiraIssue",
      "mcp__claude_ai_Atlassian__lookupJiraAccountId",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_MELI_Atlassian__create_meli_session",
      "mcp__claude_ai_MELI_Atlassian__getAccessibleAtlassianResources",
      "mcp__claude_ai_MELI_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_MELI_Atlassian__getJiraIssue",
      "mcp__claude_ai_MELI_Atlassian__getTransitionsForJiraIssue",
      "mcp__claude_ai_MELI_Atlassian__search",
      "mcp__claude_ai_MELI_Github__pull_request_read",
      "mcp__claude_ai_MELI_Slack__create_meli_session",
      "mcp__claude_ai_MELI_Slack__slack_read_thread",
      "mcp__bigquery__dry_run_query"
    ],
    "ask": [
      "Bash(mv *)",
      "Bash(rm -f *)",
      "Bash(rm -rf *)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(chmod -R *)",
      "Bash(chown *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(fdisk *)",
      "Bash(git checkout -- . *)",
      "Bash(git clean -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(mkfs *)",
      "Bash(reboot *)",
      "Bash(shutdown *)",
      "Bash(wget * | bash *)",
      "Bash(wget * | sh *)"
    ]
  },
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "dark",
  "useAutoModeDuringPlan": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}